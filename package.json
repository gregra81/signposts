{
  "name": "signposts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mutate": "stryker run",
    "mutate:changed": "stryker run --incremental",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run mutate"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
