{
  "name": "signposts",
  "version": "0.1.1",
  "description": "Turns the corrections you type at Claude Code into reviewed team knowledge, as markdown in your own repo.",
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "knowledge-base",
    "team-knowledge",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Greg Rashkevitch",
  "homepage": "https://github.com/gregra81/signposts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregra81/signposts.git"
  },
  "bugs": {
    "url": "https://github.com/gregra81/signposts/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    ".claude-plugin/",
    "commands/",
    "hooks/hooks.json",
    "hooks/session-start.js",
    "statusline/statusline.js",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:install": "bash test/install/install.test.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mutate": "stryker run",
    "mutate:changed": "stryker run --incremental",
    "mutate:gate": "node scripts/mutation-gate.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run mutate && pnpm run mutate:gate",
    "build:hooks": "node scripts/build-hooks.mjs",
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.build.json && node scripts/build-hooks.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "signpost": "bin/signpost.js",
    "signpost-session-start": "hooks/session-start.js"
  }
}
